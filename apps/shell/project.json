{
  "name": "shell",
  "sourceRoot": "apps/shell/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rsbuild dev --config apps/shell/rsbuild.config.ts --port 3000"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rsbuild build --config apps/shell/rsbuild.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vue-tsc -p apps/shell/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/shell"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/shell/vitest.config.ts"
      }
    }
  }
}
