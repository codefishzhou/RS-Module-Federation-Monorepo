{
  "name": "rs-mf",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "NX_DAEMON=false nx run-many -t dev --projects=shell,remote-playground --parallel=2",
    "build": "NX_DAEMON=false nx run-many -t build --projects=shell,remote-playground --parallel=2",
    "lint": "NX_DAEMON=false nx run-many -t lint",
    "typecheck": "NX_DAEMON=false nx run-many -t typecheck",
    "test": "NX_DAEMON=false nx run-many -t test",
    "e2e": "playwright test",
    "format": "prettier --write apps packages tests .github package.json pnpm-workspace.yaml nx.json tsconfig.base.json eslint.config.mjs playwright.config.ts README.md",
    "format:check": "prettier --check apps packages tests .github package.json pnpm-workspace.yaml nx.json tsconfig.base.json eslint.config.mjs playwright.config.ts README.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@module-federation/rsbuild-plugin": "^0.16.0",
    "@playwright/test": "^1.52.0",
    "@rsbuild/core": "^1.3.0",
    "@rsbuild/plugin-vue": "^1.0.5",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^10.0.0",
    "nx": "^21.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "@vue/compiler-sfc": "^3.5.13"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.66.8",
    "pinia": "^3.0.1",
    "vue-router": "^4.5.0"
  }
}
